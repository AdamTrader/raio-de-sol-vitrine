    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst base64Limpo = String(item._fotoBase64 || '').replace(/^data:image\\/\\w+;base64,/, '');\n\nreturn [{\n  json: item,\n  binary: {\n    foto: {\n      data: base64Limpo,\n      mimeType: 'image/jpeg',\n      fileName: `${item.ID}.jpg`\n    }\n  }\n}];\n"
      },
      "id": "b70fd862-4f0d-49b7-8cbc-c0155ebf53ec",
      "name": "Preparar binario da foto",
      "type": "n8n-nodes-base.code",
