    {
      "parameters": {
        "jsCode": "const headers = $input.first().json.headers || {};\nconst body = $input.first().json.body || {};\nconst SENHA_ADMIN = 'TROQUE_ESTA_SENHA123';\nconst autorizado = (headers['x-admin-senha'] || '') === SENHA_ADMIN;\nreturn [{ json: { autorizado, body } }];\n"
