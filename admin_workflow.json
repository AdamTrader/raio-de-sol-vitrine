      "parameters": {
        "jsCode": "\nconst headers = $input.first().json.headers || {};\nconst senhaEnviada = headers['x-admin-senha'] || '';\nconst SENHA_ADMIN = 'TROQUE_ESTA_SENHA123';\nreturn [{ json: { autorizado: senhaEnviada === SENHA_ADMIN } }];\n"
