    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\nconst produtos = rows.map(r => ({\n  id: r['ID'],\n  codigo: r['Código'],\n  nome: r['Nome'],\n  categoria: r['Categoria'],\n  tamanho: r['Tamanho'],\n  cor: r['Cor'],\n  genero: r['Gênero'],\n  preco: Number(String(r['Preço Venda'] || '0').replace(',', '.')) || 0,\n  descricao: r['Descrição'] || '',\n  quantidade: Number(r['Quantidade']) || 0,\n  imagem: r['Imagem'] || '',\n  imagemUrl: r['Imagem'] ? `https://drive.google.com/thumbnail?id=${r['Imagem']}&sz=w1000` : ''\n}));\n\nreturn [{ json: { produtos } }];\n"
      },
