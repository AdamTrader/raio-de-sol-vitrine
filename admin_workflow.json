    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\nfunction tentarParsear(txt) {\n  try { return JSON.parse(txt); } catch (e) { return []; }\n}\n\nconst pedidos = rows.map(r => ({\n  codigo: r['Código Pedido'],\n  dataHora: r['Data/Hora'],\n  itens: tentarParsear(r['Itens (JSON)']),\n  totalEstimado: Number(r['Total Estimado']) || 0,\n  qtdItens: Number(r['Qtd Itens']) || 0,\n  status: r['Status'] || 'aguardando',\n  telefone: r['Telefone Cliente'] || ''\n})).sort((a, b) => String(b.dataHora).localeCompare(String(a.dataHora)));\n\nreturn [{ json: { pedidos } }];\n"
      },
